<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<ApplicationIcon>ico.ico</ApplicationIcon>
	<AssemblyTitle>AeroLauncher</AssemblyTitle>
	<StartupObject>GameLibraryLauncher.App</StartupObject>
	<AssemblyName>AeroLauncher</AssemblyName>
	<RootNamespace>AeroLauncher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="ico.ico" />
    <Content Include="sound\launch.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="sound\nav.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.XInput" Version="4.2.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
