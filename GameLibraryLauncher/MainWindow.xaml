<Window x:Class="MinimalGameLauncher.MainWindow"
        Icon="ico.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Launcher" Height="580" Width="1000"
        WindowStartupLocation="CenterScreen"
        Foreground="#FFFFFF" ResizeMode="NoResize" WindowStyle="None"
        WindowState="Maximized">

    <!-- Deep, premium gradient background -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#090D14" Offset="0.0"/>
            <GradientStop Color="#141B26" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <!-- The Main Dashboard Layout -->
    <Grid>
        <!-- ========================================== -->
        <!-- THE HERO BACKGROUND (Layer 0 - Bottom)      -->
        <!-- ========================================== -->
        <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="1">
            <Image.Effect>
                <BlurEffect Radius="2"/>
            </Image.Effect>
        </Image>

        <!-- Subtle gradient overlay at the bottom so Play/Settings buttons pop -->
        <Border VerticalAlignment="Bottom" Height="200" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.0"/>
                    <GradientStop Color="#B3090D14" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ========================================== -->
        <!-- TOP NAVIGATION BAR (Layer 1 - Top)          -->
        <!-- ========================================== -->
        <Grid Height="60" VerticalAlignment="Top" Margin="30,30,30,0" Panel.ZIndex="100">
            <!-- Left Side: Add / Remove -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnAddGame" Content="+ Add Game" Width="100" Height="35" Margin="0,0,10,0" 
                        Background="#1C2536" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#2C3852" 
                        Cursor="Hand" Click="BtnAddGame_Click"/>

                <Button x:Name="BtnRemoveGame" Content="Remove Game" Width="100" Height="35" Margin="0,0,10,0" 
                        Background="#361C1C" Foreground="#FF4D4D" BorderThickness="1" BorderBrush="#522C2C" 
                        Visibility="Collapsed" Cursor="Hand" Click="BtnRemoveGame_Click"/>
            </StackPanel>
            
            <TextBlock Text="Abishek's Games" Foreground="#FFFFFF" FontSize="26" FontWeight="Heavy" 
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Right Side: Quit Button -->
            <Button x:Name="BtnQuit" Content="✕ Quit" Width="80" Height="35" HorizontalAlignment="Right"
                    Background="#1C2536" Foreground="#CBD5E1" BorderThickness="1" BorderBrush="#2C3852" 
                    Cursor="Hand" Click="BtnQuit_Click"/>
        </Grid>

        <!-- ========================================== -->
        <!-- HORIZONTAL GAME LIST (Layer 2 - Top Right)  -->
        <!-- ========================================== -->
        <Grid Height="260" VerticalAlignment="Top" Margin="0,110,30,0" HorizontalAlignment="Right" Panel.ZIndex="10">
            <ScrollViewer x:Name="CarouselScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Width="800">
                <ItemsControl x:Name="CarouselItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Interactive Game Card (Cover Art Only) -->
                            <Border Width="140" Height="200" Margin="10,20,10,20" CornerRadius="8" 
                                    Cursor="Hand" MouseDown="GameCard_MouseDown" Background="#0C1017">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00E5FF" BlurRadius="25" Opacity="0.8" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- Cover Image -->
                                <Border CornerRadius="8" ClipToBounds="True">
                                    <Image Source="{Binding ImagePath, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill"/>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ========================================== -->
        <!-- SELECTED GAME NAME (Layer 3 - Mid Left)     -->
        <!-- ========================================== -->
        <TextBlock x:Name="TxtSelectedGameTitle" Text="Select a Game" 
                   Foreground="#FFFFFF" FontSize="46" FontWeight="Bold" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,180,0,0"
                   TextWrapping="Wrap" MaxWidth="500">
            <TextBlock.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- ========================================== -->
        <!-- ACTION CORNERS (Layer 4 - Bottom Edge)      -->
        <!-- ========================================== -->
        <!-- Bottom Left: Settings -->
        <Button x:Name="BtnSettings" Content="⚙ Settings" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                Margin="40,0,0,40" Background="Transparent" Foreground="#A0AABF" FontSize="16" BorderThickness="0" 
                Cursor="Hand" Panel.ZIndex="150" Click="BtnSettings_Click"/>

        <!-- Bottom Right: PLAY BUTTON -->
        <Button x:Name="BtnPlayGame" Content="PLAY ▶" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="0,0,50,40" Width="180" Height="60" Background="#00E5FF" Foreground="#090D14" 
                FontSize="24" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Panel.ZIndex="150" 
                Click="BtnPlayGame_Click"/>

        <!-- ========================================== -->
        <!-- OVERLAYS (Add Game & Settings)             -->
        <!-- ========================================== -->

        <!-- Add Game Overlay -->
        <Grid x:Name="AddGameOverlay" Background="#D9090D14" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Width="400" Height="270" Background="#141B26" CornerRadius="12" BorderBrush="#2C3852" BorderThickness="1">
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <TextBlock Text="Add New Game" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Game Name Input with Custom Placeholder -->
                    <Grid Margin="0,0,0,15">
                        <TextBox x:Name="TxtGameName" Background="#0C1017" Foreground="#FFFFFF" BorderBrush="#2C3852" 
                                 Height="35" Padding="5" VerticalContentAlignment="Center"/>
                        <TextBlock IsHitTestVisible="False" Text="Game Name..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#5E6C84">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtGameName}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Hidden text boxes to store the paths -->
                    <TextBox x:Name="TxtImagePath" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtHeroImagePath" Visibility="Collapsed"/>

                    <!-- Executable Input & Browse -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtGamePath" Grid.Column="0" Background="#0C1017" Foreground="#FFFFFF" 
                                 BorderBrush="#2C3852" Height="35" Padding="5" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Background="#2C3852" 
                                Foreground="#FFFFFF" BorderThickness="0" Click="BtnBrowse_Click" Cursor="Hand"/>
                    </Grid>

                    <!-- The Custom Image Browse Buttons -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnBrowseImage" Grid.Column="0" Content="Browse Cover Image..." Height="30" Background="#1C2536" 
                                Foreground="#A0AABF" BorderBrush="#2C3852" BorderThickness="1" Cursor="Hand" Click="BtnBrowseImage_Click"/>
                        <Button x:Name="BtnBrowseHero" Grid.Column="2" Content="Browse Hero Banner..." Height="30" Background="#1C2536" 
                                Foreground="#A0AABF" BorderBrush="#2C3852" BorderThickness="1" Cursor="Hand" Click="BtnBrowseHero_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelOverlay" Content="Cancel" Width="80" Height="35" Background="Transparent" 
                                Foreground="#A0AABF" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancelOverlay_Click"/>
                        <Button x:Name="BtnSaveNewGame" Content="Save" Width="80" Height="35" Background="#00E5FF" 
                                Foreground="#090D14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSaveNewGame_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings Overlay -->
        <Grid x:Name="SettingsOverlay" Background="#D9090D14" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Width="420" Height="260" Background="#141B26" CornerRadius="12" BorderBrush="#2C3852" BorderThickness="1">
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" Foreground="#5E6C84" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="SteamGridDB API Key:" Foreground="#A0AABF" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtApiKey" Foreground="#FFFFFF" Background="#0C1017" BorderBrush="#2C3852" Height="30" Margin="0,0,0,15" Padding="5" />

                    <!-- Update Status & Action -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtUpdateStatus" Grid.Column="0" Text="Ready" Foreground="#A0AABF" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <Button x:Name="BtnCheckUpdates" Grid.Column="1" Content="Check Updates" Width="115" Height="30"
                                Background="#1C2536" Foreground="#00E5FF" BorderBrush="#2C3852" BorderThickness="1"
                                Cursor="Hand" Click="BtnCheckUpdates_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Background="Transparent" Foreground="#A0AABF" BorderThickness="0" Click="BtnCancelSettings_Click"/>
                        <Button Content="Save Settings" Width="100" Height="30" Background="#00E5FF" Foreground="#090D14" FontWeight="Bold" BorderThickness="0" Click="BtnSaveSettings_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>